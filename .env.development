# 开发环境配置
VITE_API_BASE_URL=/api
VITE_APP_ENV=development
VITE_AGENT_MOCK=true
# 通知中心 feature flag（notification-center）。prod env 不设此变量 → 铃铛隐藏。
VITE_ENABLE_NOTIFICATIONS=true
# 文档系统 feature flag（document-system）。prod env 不设此变量 → "打开编辑"入口隐藏。
VITE_ENABLE_DOCUMENT_SYSTEM=true
# 会议副驾 feature flag（meeting-copilot）。prod env 不设此变量 → 导航入口隐藏、路由不注册。
VITE_ENABLE_MEETING_COPILOT=true
# 说话人色标 feature flag（meeting-speaker-diarization）。prod env 不设此变量 → 转写无说话人标签（与现状逐字一致）。
VITE_ENABLE_MEETING_DIARIZATION=true
