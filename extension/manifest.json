{
  "manifest_version": 3,
  "name": "有数选题采集",
  "version": "1.0.0",
  "description": "在小红书页面一键采集当前笔记，归一化后上送有数选题库（仅采集公开内容）。",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "*://*.xiaohongshu.com/*",
    "https://youshu.asia/*",
    "http://49.233.219.254/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "有数选题采集"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.xiaohongshu.com/*"],
      "js": ["page-state-bridge.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.xiaohongshu.com/*"],
      "js": ["lib/parse.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://youshu.asia/*",
        "http://49.233.219.254/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["connect-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://youshu.asia/*",
      "http://49.233.219.254/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}
