server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # 允许上传最大 50M 的文件 (修复 413 Request Entity Too Large)
    client_max_body_size 50M;

    # Docker 内置 DNS，valid=5s 让变量形式的 proxy_pass 每 5s 重解析 upstream IP，
    # 避免后端容器 rm+run 换 IP 后 nginx 卡旧 IP 导致 502（开源 nginx 原生机制）。
    # 127.0.0.11 在 Docker 容器内会 forward 到宿主机 DNS，对公网域名同样生效。
    # resolver_timeout 5s：默认 30s 太长，DNS 临时不可用时 worker 会被挂 30s/请求。
    resolver 127.0.0.11 valid=5s ipv6=off;
    resolver_timeout 5s;

    # 健康检查
    location /health {
        access_log off;
        return 200 "healthy\n";
    }

    # 同源 API 反向代理，避免浏览器跨域；上游地址由环境变量注入
    location /api/ {
        # proxy_pass 含变量时才走 resolver 动态解析，无变量则启动时解析后永久缓存。
        # DO NOT INLINE: 必须保留 set $upstream + proxy_pass $upstream 两行分写。
        # 如果"简化"成 proxy_pass "${API_PROXY_UPSTREAM}"; 会退回到 nginx 启动时
        # 解析 DNS 一次后永久缓存的静态模式，本次修复失效。
        set $upstream "${API_PROXY_UPSTREAM}";
        # 剥掉 /api 前缀（变量 proxy_pass 不会自动替换 location）
        rewrite ^/api(/.*)$ $1 break;
        proxy_pass $upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;

        # SSE/流式响应支持（AI 聊天需要）
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header Connection '';
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        chunked_transfer_encoding on;
    }

    # 兼容旧版前端直调 /v1/*（避免误回落到 index.html）
    location /v1/ {
        set $upstream "${API_PROXY_UPSTREAM}";
        # /v1/ 前缀保留，直接转发 $uri
        proxy_pass $upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;

        # SSE/流式响应支持
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header Connection '';
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        chunked_transfer_encoding on;
    }

    # 静态资源缓存（文件名含 hash，可安全长期缓存）
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # 前端路由支持（HTML 禁止缓存，确保部署后用户自动获取最新版）
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0";
    }
}
