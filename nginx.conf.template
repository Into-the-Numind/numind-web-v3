server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # 健康检查
    location /health {
        access_log off;
        return 200 "healthy\n";
    }

    # 同源 API 反向代理，避免浏览器跨域；上游地址由环境变量注入
    location /api/ {
        proxy_pass ${API_PROXY_PASS};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;

        # SSE/流式响应支持（AI 聊天需要）
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header Connection '';
        proxy_read_timeout 300s;
        chunked_transfer_encoding on;
    }

    # 兼容旧版前端直调 /v1/*（避免误回落到 index.html）
    location /v1/ {
        proxy_pass ${API_PROXY_PASS}v1/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;

        # SSE/流式响应支持
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header Connection '';
        proxy_read_timeout 300s;
        chunked_transfer_encoding on;
    }

    # 兼容以 /v3/ 作为前缀的构建产物路径
    location ^~ /v3/assets/ {
        alias /usr/share/nginx/html/assets/;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # 兼容 /v3/favicon.svg
    location = /v3/favicon.svg {
        alias /usr/share/nginx/html/favicon.svg;
        expires 7d;
        add_header Cache-Control "public";
    }

    # 兼容 /v3/ 前端路由（HTML 禁止缓存，确保部署后用户自动获取最新版）
    location /v3/ {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0";
    }

    # 静态资源缓存（文件名含 hash，可安全长期缓存）
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # 前端路由支持（HTML 禁止缓存，确保部署后用户自动获取最新版）
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0";
    }
}
